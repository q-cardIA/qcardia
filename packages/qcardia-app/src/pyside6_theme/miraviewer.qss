* {
  font-family: "Inter", "Segoe UI", "Roboto", sans-serif;
  color: #f0f0f5;
  selection-background-color: #3b82f6;
  selection-color: #ffffff;
}

QWidget {
  background-color: #0a0a0f;
  color: #f0f0f5;
}

QMainWindow,
QDialog {
  background-color: #0a0a0f;
}

QFrame[role="panel"],
QGroupBox,
QMenu {
  background-color: #12121a;
  border: 1px solid #2a2a3a;
  border-radius: 12px;
}

QGroupBox {
  margin-top: 10px;
  padding: 12px;
}

QGroupBox::title {
  subcontrol-origin: margin;
  left: 12px;
  top: 0px;
  color: #8a8a9a;
}

QLabel[textRole="secondary"] {
  color: #8a8a9a;
}

QLabel[textRole="tertiary"] {
  color: #6f7084;
}

QLabel[textRole="accent"] {
  color: #3b82f6;
}

QPushButton {
  background-color: #1a1a24;
  color: #8a8a9a;
  border: 1px solid #2a2a3a;
  border-radius: 8px;
  padding: 6px 12px;
}

QPushButton:hover {
  background-color: #2a2a3a;
  color: #f0f0f5;
}

QPushButton:pressed {
  background-color: #313146;
}

QPushButton:disabled {
  background-color: #1a1a24;
  border-color: #2a2a3a;
  color: #6f7084;
}

QPushButton[variant="primary"] {
  background-color: #3b82f6;
  border: 1px solid #3b82f6;
  color: #ffffff;
  font-weight: 600;
}

QPushButton[variant="primary"]:hover {
  background-color: #2563eb;
  border-color: #2563eb;
}

QPushButton[variant="primary"]:pressed {
  background-color: #1e4fd6;
  border-color: #1e4fd6;
}

QPushButton[variant="ghost"] {
  background-color: transparent;
  border: 1px solid transparent;
  color: #8a8a9a;
}

QPushButton[variant="ghost"]:hover {
  background-color: #1a1a24;
  border: 1px solid #2a2a3a;
  color: #f0f0f5;
}

QPushButton[variant="danger"] {
  background-color: rgba(248, 113, 113, 0.15);
  border: 1px solid rgba(248, 113, 113, 0.4);
  color: #fca5a5;
}

QPushButton[variant="danger"]:hover {
  background-color: rgba(248, 113, 113, 0.25);
  color: #fecaca;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit,
QComboBox {
  background-color: #0a0a0f;
  color: #f0f0f5;
  border: 1px solid #2a2a3a;
  border-radius: 8px;
  padding: 6px 8px;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateEdit:hover,
QTimeEdit:hover,
QDateTimeEdit:hover,
QComboBox:hover {
  border-color: #3a3a4a;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QDateTimeEdit:focus,
QComboBox:focus {
  border: 1px solid #3b82f6;
}

QComboBox::drop-down {
  border: none;
  width: 20px;
}

QComboBox QAbstractItemView {
  background-color: #12121a;
  color: #f0f0f5;
  border: 1px solid #2a2a3a;
  selection-background-color: #3b82f6;
  selection-color: #ffffff;
  outline: 0;
}

QCheckBox,
QRadioButton {
  color: #8a8a9a;
  spacing: 8px;
}

QCheckBox::indicator,
QRadioButton::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid #2a2a3a;
  background-color: #1a1a24;
}

QCheckBox::indicator {
  border-radius: 4px;
}

QRadioButton::indicator {
  border-radius: 7px;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
  background-color: #3b82f6;
  border-color: #3b82f6;
}

QTabWidget::pane {
  border: 1px solid #2a2a3a;
  border-radius: 8px;
  background-color: #12121a;
  top: -1px;
}

QTabBar::tab {
  background-color: #1a1a24;
  color: #8a8a9a;
  border: 1px solid #2a2a3a;
  border-bottom: none;
  border-top-left-radius: 8px;
  border-top-right-radius: 8px;
  padding: 6px 12px;
  margin-right: 4px;
}

QTabBar::tab:selected {
  background-color: #3b82f6;
  color: #ffffff;
  border-color: #3b82f6;
}

QTabBar::tab:hover:!selected {
  color: #f0f0f5;
  background-color: #2a2a3a;
}

QListView,
QTreeView,
QTableView {
  background-color: #0a0a0f;
  color: #f0f0f5;
  alternate-background-color: #12121a;
  border: 1px solid #2a2a3a;
  border-radius: 8px;
  gridline-color: #2a2a3a;
  outline: 0;
}

QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected {
  background-color: #3b82f6;
  color: #ffffff;
}

QHeaderView::section {
  background-color: #12121a;
  color: #8a8a9a;
  border: 0;
  border-right: 1px solid #2a2a3a;
  border-bottom: 1px solid #2a2a3a;
  padding: 6px 8px;
}

QProgressBar {
  background-color: #1a1a24;
  border: 1px solid #2a2a3a;
  border-radius: 6px;
  text-align: center;
  color: #f0f0f5;
}

QProgressBar::chunk {
  background-color: #3b82f6;
  border-radius: 6px;
}

QSlider::groove:horizontal {
  background: #1a1a24;
  border: 1px solid #2a2a3a;
  height: 6px;
  border-radius: 3px;
}

QSlider::handle:horizontal {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #3b82f6, stop:1 #2563eb);
  border: 1px solid rgba(59, 130, 246, 0.25);
  width: 18px;
  margin: -7px 0;
  border-radius: 9px;
}

QSlider::handle:horizontal:hover {
  background: #2563eb;
}

QSlider::groove:vertical {
  background: #1a1a24;
  border: 1px solid #2a2a3a;
  width: 6px;
  border-radius: 3px;
}

QSlider::handle:vertical {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #3b82f6, stop:1 #2563eb);
  border: 1px solid rgba(59, 130, 246, 0.25);
  height: 18px;
  margin: 0 -7px;
  border-radius: 9px;
}

QSlider::handle:vertical:hover {
  background: #2563eb;
}

QScrollBar:vertical {
  background: #12121a;
  width: 8px;
  margin: 0;
  border: none;
}

QScrollBar::handle:vertical {
  background: #2a2a3a;
  min-height: 24px;
  border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
  background: #3a3a4a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  height: 0;
}

QScrollBar:horizontal {
  background: #12121a;
  height: 8px;
  margin: 0;
  border: none;
}

QScrollBar::handle:horizontal {
  background: #2a2a3a;
  min-width: 24px;
  border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
  background: #3a3a4a;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
  width: 0;
}

QToolTip {
  background-color: #12121a;
  color: #f0f0f5;
  border: 1px solid #2a2a3a;
  border-radius: 6px;
  padding: 4px 6px;
}

QMenu::item {
  background-color: transparent;
  color: #f0f0f5;
  padding: 6px 10px;
  border-radius: 6px;
}

QMenu::item:selected {
  background-color: #1a1a24;
}

QStatusBar {
  background-color: #12121a;
  border-top: 1px solid #2a2a3a;
  color: #8a8a9a;
}
